# Shared .env template for every node (stash: node_home/.env). bootstrap.sh copies this
# to <repo>/.env on a fresh node. Secrets stay BLANK here -- the stash is a world-readable
# shared volume -- paste them into the per-node copy only.

# HuggingFace cache home. Point at the SAME persistent cache the paths YAML uses, so
# downloads/tokenizers reuse the surviving cache (loading_io reads {hf_cache_root}/hub).
# Moved ssd-2 -> cold-1 on 2026-08-18 (ssd-3/ssd-2 copies frozen as fallback).
HF_HOME=/mnt/cold-1/soar-subliminal/angela/hf_cache

# HF auth token -- OPTIONAL: PolyPythias (and Qwen3-32B) are public, so this is only needed
# for gated/private repos (Llama 3, Gemma 3) or to dodge anonymous rate limits.
# NEVER fill this in here; only in the node-local <repo>/.env copy.
HF_TOKEN=

# Weights & Biases
WANDB_PROJECT=soar-subliminal
WANDB_MODE=offline          # offline|online|disabled. Sweeps force 'disabled' regardless.

# GPU policy -- default: all GPUs. Narrow this in the node-local copy if a node is shared
# (e.g. 4,5,6,7); the jobqueue gpu_policy.<host>.json is the finer-grained per-card control.
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
