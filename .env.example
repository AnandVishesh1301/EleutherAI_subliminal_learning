# Template: copy to <repo>/.env and fill in per machine. Never commit secrets.

# HuggingFace cache home. Point at the SAME persistent cache the paths YAML uses
# (configs/paths/paths_local.yaml: hf_cache_root), so downloads and tokenizers are reused.
HF_HOME=<absolute path to the HF cache>

# HF auth token -- OPTIONAL: PolyPythias (and Qwen3-32B) are public, so this is only needed
# for gated/private repos (Llama 3, Gemma 3) or to dodge anonymous rate limits.
HF_TOKEN=

# Weights & Biases
WANDB_PROJECT=subliminal-learning
WANDB_MODE=offline          # offline|online|disabled. Sweeps force 'disabled' regardless.

# GPU policy -- default: all GPUs. Narrow this if the machine is shared (e.g. 4,5,6,7);
# the jobq gpu_policy.<host>.json is the finer-grained per-card control.
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# Optional: comma-separated hostnames whose recent jobq timings count as tier-1 ETA priors
# (subliminal_learning.ops.eta_priors.TIER_NODES). Empty = no tier-1 nodes.
SL_ETA_TIER_NODES=
